# Copy to .env and fill in the two AWS values. Everything else has a working
# default, so `cp .env.example .env` is enough to run everything local.
#
#   cp .env.example .env
#
# .env is gitignored and must stay that way: it is the file that will hold an
# account id, and in other people's variants of this project, keys.

# MLflow
# Use host.docker.internal when running inside Docker (docker compose up)
# Use localhost:5000 when running locally (python app/main.py)
MLFLOW_TRACKING_URI="http://localhost:5000"
MLFLOW_EXPERIMENT_NAME="finbert-evaluation"
MODEL_NAME="finbert"

# The registry alias the API loads. "production" is the alias promote.py
# assigns. The starter shipped MODEL_STAGE=dev, which resolves to nothing until
# someone creates a `dev` alias by hand — the API then fails to load the model
# and /health reports 503 with a registry error that names an alias nobody set.
MODEL_STAGE=production

# AWS / ECR — fill these in; they are account-specific.
# These are NOT used by the local run. The CI pipeline reads region and
# registry from GitHub repository secrets, not from this file.
AWS_REGION=""
AWS_ACCOUNT_ID=""
ECR_REGISTRY=${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com
ECR_REPOSITORY="finbert-api"

# Model source: "mlflow" (default) or "huggingface" (CI/prod)
MODEL_SOURCE=mlflow
HF_MODEL_ID=baptle/FinBERT_market_based
HF_DATASET_ID=baptle/financial_headlines_market_based

# API
# API_HOST is the address the server BINDS to. 0.0.0.0 means every interface.
# It is not an address to connect TO — monitoring/stream.py therefore uses
# MONITOR_API_HOST for that, defaulting to localhost.
API_HOST=0.0.0.0
API_PORT=8000

# ---------------------------------------------------------------------------
# A/B testing against a candidate model version (stand-out)
# ---------------------------------------------------------------------------
# Percentage of /predict traffic routed to the candidate. 0 disables it.
# Out-of-range values are clamped and unparseable ones treated as 0: this
# governs routing, so a bad value degrades to "all production" rather than
# taking the service down.
AB_CANDIDATE_PERCENT=10

# Which registered version is the candidate. A version pin wins over the
# alias, and is what you want for a real comparison — an alias can be moved
# underneath a running experiment, at which point the two arms being compared
# are no longer the two models whose numbers you are reading.
AB_CANDIDATE_ALIAS=candidate
# AB_CANDIDATE_VERSION=9

# NOTE. The candidate is only attempted when MODEL_SOURCE=mlflow. A candidate
# is a registered VERSION and only the registry has versions, so with
# MODEL_SOURCE=huggingface there is nothing to compare against — and MLflow's
# client spends about a minute retrying a refused connection, which would be a
# minute added to every container start to discover a registry that was never
# going to be there. GET /ab-status reports which of these applies.
